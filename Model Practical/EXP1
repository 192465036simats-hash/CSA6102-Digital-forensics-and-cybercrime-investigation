        "import os\n",
        "from datetime import datetime\n",
        "import hashlib\n",
        "def get_hash(file):\n",
        "    with open(file, \"rb\") as f:\n",
        "        return hashlib.sha256(f.read()).hexdigest()\n",
        "dummy_file_name = \"sample.txt\"\n",
        "if not os.path.exists(dummy_file_name):\n",
        "    with open(dummy_file_name, \"w\") as f:\n",
        "        f.write(\"This is a dummy file content.\")\n",
        "    print(f\"Created a dummy file: {dummy_file_name}\")\n",
        "file = input(\"Enter file name: \")\n",
        "history = []\n",
        "history.append(f\"{datetime.now()} - Collected by Investigator\")\n",
        "history.append(f\"{datetime.now()} - Transferred to Analyst A\")\n",
        "history.append(f\"{datetime.now()} - Transferred to Analyst B\")\n",
        "print(\"Evidence ID: EV001\")\n",
        "print(\"Source: Laptop\")\n",
        "print(\"SHA-256:\", get_hash(file))\n",
        "print(\"History:\")\n",
        "for i in history:\n",
        "    print(i)\n",
        "print(\"Integrity Status: Hash Consistent\")"
      ]
