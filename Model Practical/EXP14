        "import hashlib\n",
        "\n",
        "db = {}\n",
        "\n",
        "file = input(\"File name: \")\n",
        "h = hashlib.sha256(file.encode()).hexdigest()\n",
        "\n",
        "if h in db:\n",
        "    print(\"Match Found:\", db[h])\n",
        "else:\n",
        "    db[h] = file\n",
        "    print(\"New Evidence Added\")"
